# ClipCascade app environment
# Copy to app.env and fill in your values

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=clipcascade.example.com
BASE_DOMAIN_NAME=example.com

# Admin credentials
APP_ADMIN_USER=admin
APP_ADMIN_PASS=replace-with-a-random-password

# Application secret
APP_SECRET_KEY=replace-with-a-random-password

# Max message size in MB
CC_MAX_MESSAGE_SIZE=1
